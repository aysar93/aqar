// Optional READ-ONLY compatibility for existing booking R2 videos.
// New booking uploads use Firebase Storage. No booking Worker secret or bridge.
// Keep only if old R2 booking records exist; never replace reels bindings.
{
  "r2_buckets": [
    {"binding": "BOOKINGS_BUCKET", "bucket_name": "REPLACE_WITH_EXISTING_PRIVATE_BOOKINGS_BUCKET"}
  ]
  // Keep r2.dev and public custom domains disabled.
}
