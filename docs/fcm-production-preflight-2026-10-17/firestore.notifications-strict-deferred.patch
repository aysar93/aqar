--- production/firestore.rules
+++ proposed/notifications-only.rules
@@ -723,8 +723,28 @@
     // ==================================================
     match /notifications/{notificationId} {
 
+      function migrated(d) { return d.get('pushTransport', '') == 'fcm_v1'; }
+      function validPushSource(d) {
+        return activeUser() &&
+          d.get('createdBy', request.auth.uid) == request.auth.uid &&
+          (isAdmin() ||
+            (d.type == 'chat_message' && d.chatId == request.auth.uid &&
+              get(/databases/$(database)/documents/settings/app_settings).data.adminUid == d.userId &&
+              get(/databases/$(database)/documents/chats/$(d.chatId)/messages/$(d.messageId)).data.senderId == request.auth.uid &&
+              get(/databases/$(database)/documents/chats/$(d.chatId)/messages/$(d.messageId)).data.get('deletedAt', null) == null) ||
+            (d.type == 'comment' &&
+              get(/databases/$(database)/documents/properties/$(d.propertyId)).data.publisherUid == d.userId &&
+              get(/databases/$(database)/documents/properties/$(d.propertyId)/comments/$(d.commentId)).data.userId == request.auth.uid) ||
+            (d.type == 'reply' &&
+              get(/databases/$(database)/documents/properties/$(d.propertyId)/comments/$(d.commentId)).data.userId == d.userId &&
+              get(/databases/$(database)/documents/properties/$(d.propertyId)/comments/$(d.commentId)/replies/$(d.replyId)).data.userId == request.auth.uid));
+      }
+
       // الإنشاء للمستخدمين المسجلين والأدمن
-      allow create: if isSignedIn();
+      // Legacy payloads are not an authorization bypass. Older senders without
+      // verifiable source IDs need the authenticated source-trigger path.
+      allow create: if isSignedIn() && validPushSource(request.resource.data) &&
+        (!migrated(request.resource.data) || request.resource.data.createdBy == request.auth.uid);
 
       // القراءة للأدمن أو لصاحب الإشعار أو للتنبيهات العامة
 allow read: if isSignedIn() &&
@@ -734,11 +754,14 @@
 );
 
