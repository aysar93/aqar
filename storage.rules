rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() { return active() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true; }
    function bookingFinance() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('canReviewBookingPayments', false) == true; }
    function active() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isBlocked', false) == false; }
    match /booking_banner_media/{authorUid}/{fileName} {
      allow read: if true;
      // Retained legacy objects remain readable; new uploads use the server lifecycle.
      allow create: if false;
      allow update, delete: if false;
    }
    match /booking_media/{venueId}/{authorUid}/{fileName} {
      // Historical venue records are served through the same live gateway.
      allow read, write: if false;
    }
    match /booking_media_v3/{venueId}/{authorUid}/{fileName} {
      // Live authorization is performed by the booking-only gateway.
      // Neither public ACLs nor bearer download tokens are used.
      allow read, write: if false;
    }

    match /booking_ownership_documents/{venueId}/{authorUid}/{fileName} {
      function venue() { return firestore.get(/databases/(default)/documents/booking_venues/$(venueId)).data; }
      allow read: if active() && (admin() || venue().ownerId == request.auth.uid);
      allow create: if resource == null && active() && request.auth.uid == authorUid && venue().ownerId == authorUid && venue().verificationStatus in ['pending', 'rejected'] &&
        request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024 &&
        ((fileName.matches('[A-Za-z0-9_-]+[.]jpg') && request.resource.contentType == 'image/jpeg') ||
         (fileName.matches('[A-Za-z0-9_-]+[.]png') && request.resource.contentType == 'image/png') ||
         (fileName.matches('[A-Za-z0-9_-]+[.]pdf') && request.resource.contentType == 'application/pdf'));
      allow update, delete: if false;
    }
    match /subscription_receipts/{subscriptionId}/{authorUid}/{fileName} {
      function subscription() { return firestore.get(/databases/(default)/documents/office_subscriptions/$(subscriptionId)).data; }
      allow read: if active() && (admin() || subscription().ownerId == request.auth.uid);
      allow create: if resource == null && active() && request.auth.uid == authorUid && subscription().ownerId == request.auth.uid &&
        subscription().status == 'pending' && fileName.matches('[0-9]+[.]jpg') &&
        request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }
    match /booking_receipts/{bookingId}/{authorUid}/{fileName} {
      function booking() { return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data; }
      allow read: if active() && (admin() || bookingFinance() || booking().customerId == request.auth.uid || booking().ownerId == request.auth.uid);
      allow create: if resource == null && active() && request.auth.uid == authorUid && booking().customerId == request.auth.uid &&
        booking().status == 'held' && booking().holdUntil > request.time.toMillis() &&
        fileName.matches('[0-9]+[.]jpg') && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }
    match /chat_images/{chatId}/{authorUid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == chatId || admin());
      allow create: if active() && request.auth.uid == authorUid &&
        (request.auth.uid == chatId || admin()) &&
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.get('isClosed', false) == false &&
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.get('isBlocked', false) == false &&
        firestore.get(/databases/(default)/documents/settings/app_settings).data.get('allowChat', true) == true &&
        fileName.matches('[0-9]+[.](jpg|png)') && request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png'];
      allow update: if false;
      allow delete: if active() && request.auth.uid == authorUid;
    }
    match /chat_audio/{chatId}/{authorUid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == chatId || admin());
      allow create: if active() && request.auth.uid == authorUid &&
        (request.auth.uid == chatId || admin()) &&
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.get('isClosed', false) == false &&
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.get('isBlocked', false) == false &&
        firestore.get(/databases/(default)/documents/settings/app_settings).data.get('allowChat', true) == true &&
        firestore.get(/databases/(default)/documents/settings/app_settings).data.get('chatPreferences', {}).get('voiceEnabled', true) == true &&
        fileName.matches('[0-9]+[.]m4a') && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType == 'audio/mp4';
      allow update: if false;
      allow delete: if active() && request.auth.uid == authorUid;
    }
  }
}
